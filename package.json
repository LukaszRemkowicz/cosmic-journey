{
  "name": "cosmic-journey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:http": "node --test tests/static-http.node-test.mjs",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/release-tag.mjs --check",
    "release:tag": "node scripts/release-tag.mjs"
  },
  "dependencies": {
    "geotiff": "3.0.5",
    "mediabunny": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
